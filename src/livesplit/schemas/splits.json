{
    "$schema": "http://json-schema.org/draft-07/schema",
    "definitions": {
        "time": {
            "type": "string",
            "pattern": "\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?"
        },
        "times": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "state": {
                        "type": "string",
                        "enum": [
                            "completed",
                            "forfeit"
                        ]
                    },
                    "time": {
                        "$ref": "#/definitions/time"
                    },
                    "milliseconds": {
                        "type": "number"
                    }
                },
                "required": [
                    "state",
                    "time",
                    "milliseconds"
                ]
            }
        }
    },
    "oneOf": [
        {
            "type": "null"
        },
        {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "end": {
                    "$ref": "#/definitions/time"
                },
                "splits": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "time": {
                                "$ref": "#/definitions/time"
                            },
                            "milliseconds": {
                                "type": "number"
                            },
                            "progress": {
                                "type": "number"
                            },
                            "times": {
                                "$ref": "#/definitions/times"
                            }
                        },
                        "required": [
                            "name",
                            "time",
                            "progress",
                            "milliseconds",
                            "times"
                        ]
                    }
                }
            },
            "required": [
                "end", 
                "splits"
            ]
        }
    ]
}